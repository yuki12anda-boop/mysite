{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: gcc build (current file)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g", "-Wall",
        "-finput-charset=UTF-8",
        "-fexec-charset=CP932",
        "${file}",
        "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
